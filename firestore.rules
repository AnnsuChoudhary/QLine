rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isVerifiedOrgAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin';
    }

    function publicDomain(email) {
      return email.matches('.*@(gmail\\.com|yahoo\\.com|hotmail\\.com|outlook\\.com|icloud\\.com|proton\\.me)$');
    }

    function validOrgAdminProfile(uid, orgId) {
      return request.auth.uid == uid
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'org_admin'
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.orgId == orgId;
    }

    function isVerifiedOrgAdminFor(orgId) {
      return isVerifiedOrgAdmin()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUid == request.auth.uid;
    }

    function hasRequiredBookingProfile(orgId, uid) {
      let organization = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      let requiredFields = organization.get('bookingVerification', {}).get('requiredProfileFields', []);
      let userPath = /databases/$(database)/documents/users/$(uid);
      return requiredFields is list
        && requiredFields.hasOnly(['admissionId', 'employeeId', 'department'])
        && requiredFields.size() <= 3
        && exists(userPath)
        && (
          !requiredFields.hasAny(['admissionId'])
          || (
            get(userPath).data.get('admissionId', '') is string
            && get(userPath).data.get('admissionId', '').matches('.*\\S.*')
          )
        )
        && (
          !requiredFields.hasAny(['employeeId'])
          || (
            get(userPath).data.get('employeeId', '') is string
            && get(userPath).data.get('employeeId', '').matches('.*\\S.*')
          )
        )
        && (
          !requiredFields.hasAny(['department'])
          || (
            get(userPath).data.get('department', '') is string
            && get(userPath).data.get('department', '').matches('.*\\S.*')
          )
        );
    }

    function isEligibleCustomerForOrg(orgId, uid) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data
          .get('bookingVerification', {}).get('requiredEmailDomain', '') is string
        && get(/databases/$(database)/documents/organizations/$(orgId)).data
          .get('bookingVerification', {}).get('requiredEmailDomainPattern', '') is string
        && (
          (
            get(/databases/$(database)/documents/organizations/$(orgId)).data
              .get('bookingVerification', {}).get('requiredEmailDomain', '') == ''
            && get(/databases/$(database)/documents/organizations/$(orgId)).data
              .get('bookingVerification', {}).get('requiredEmailDomainPattern', '') == ''
          )
          || (
            get(/databases/$(database)/documents/organizations/$(orgId)).data
              .get('bookingVerification', {}).get('requiredEmailDomain', '') != ''
            && get(/databases/$(database)/documents/organizations/$(orgId)).data
              .get('bookingVerification', {}).get('requiredEmailDomainPattern', '') != ''
            && request.auth.token.email.matches(
              '(?i).*@'
                + get(/databases/$(database)/documents/organizations/$(orgId)).data
                  .get('bookingVerification', {}).get('requiredEmailDomainPattern', '')
                + '$'
            )
          )
        )
        && hasRequiredBookingProfile(orgId, uid);
    }

    function bookingHistoryWithinLimits(orgId, uid) {
      let organization = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      let policy = organization.get('bookingIntegrity', {});
      let limits = getAfter(bookingLimitPath(orgId, uid)).data;
      let maxNoShows = policy.get('maxNoShows', 3);
      let maxCancellations = policy.get('maxCancellations', 5);
      let noShowCount = limits.get('noShowCount', 0);
      let cancellationCount = limits.get('cancellationCount', 0);
      return policy is map
        && maxNoShows is int
        && maxNoShows >= 0
        && maxNoShows <= 20
        && maxCancellations is int
        && maxCancellations >= 0
        && maxCancellations <= 20
        && noShowCount is int
        && noShowCount >= 0
        && cancellationCount is int
        && cancellationCount >= 0
        && (maxNoShows == 0 || noShowCount < maxNoShows)
        && (maxCancellations == 0 || cancellationCount < maxCancellations);
    }

    function bookingLimitPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/bookingLimits/$(uid);
    }

    function dailyBookingLimitPath(orgId, uid, date) {
      return /databases/$(database)/documents/organizations/$(orgId)/bookingLimits/$(uid)/days/$(date);
    }

    function queueTokenPath(orgId, queueId, tokenId) {
      return /databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(tokenId);
    }

    function validNewBookingLimitEvent(orgId, uid, queueId, tokenId, date) {
      return existsAfter(queueTokenPath(orgId, queueId, tokenId))
        && getAfter(queueTokenPath(orgId, queueId, tokenId)).data.userId == uid
        && getAfter(queueTokenPath(orgId, queueId, tokenId)).data.queueId == queueId
        && getAfter(queueTokenPath(orgId, queueId, tokenId)).data.queueDate == date
        && getAfter(queueTokenPath(orgId, queueId, tokenId)).data.limitTracked == true
        && getAfter(queueTokenPath(orgId, queueId, tokenId)).data.status in ['scheduled', 'waiting'];
    }

    function bookingCountsWithinLimits(orgId, uid, queueId, tokenId, date) {
      return existsAfter(bookingLimitPath(orgId, uid))
        && existsAfter(dailyBookingLimitPath(orgId, uid, date))
        && getAfter(bookingLimitPath(orgId, uid)).data.lastMutationTokenId == tokenId
        && getAfter(bookingLimitPath(orgId, uid)).data.lastMutationQueueId == queueId
        && getAfter(bookingLimitPath(orgId, uid)).data.activeTotal <= 5
        && getAfter(bookingLimitPath(orgId, uid)).data.activeByQueue.get(queueId, 0) <= 3
        && getAfter(dailyBookingLimitPath(orgId, uid, date)).data.lastMutationTokenId == tokenId
        && getAfter(dailyBookingLimitPath(orgId, uid, date)).data.lastMutationQueueId == queueId
        && getAfter(dailyBookingLimitPath(orgId, uid, date)).data.date == date
        && getAfter(dailyBookingLimitPath(orgId, uid, date)).data.total <= 10
        && getAfter(dailyBookingLimitPath(orgId, uid, date)).data.byQueue.get(queueId, 0) <= 5
        && bookingHistoryWithinLimits(orgId, uid);
    }

    function tokenLimitWasDecremented(orgId, queueId, tokenId, uid) {
      return exists(bookingLimitPath(orgId, uid))
        && existsAfter(bookingLimitPath(orgId, uid))
        && getAfter(bookingLimitPath(orgId, uid)).data.lastMutationTokenId == tokenId
        && getAfter(bookingLimitPath(orgId, uid)).data.lastMutationQueueId == queueId
        && getAfter(bookingLimitPath(orgId, uid)).data.activeTotal
          == get(bookingLimitPath(orgId, uid)).data.activeTotal - 1
        && getAfter(bookingLimitPath(orgId, uid)).data.activeByQueue.get(queueId, 0)
          == get(bookingLimitPath(orgId, uid)).data.activeByQueue.get(queueId, 0) - 1;
    }

    function tokenCanBecomeInactive(orgId, queueId, tokenId) {
      return resource.data.limitTracked != true
        || (
          isVerifiedOrgAdminFor(orgId)
          && (
            !(resource.data.userId is string)
            || resource.data.userId == ''
            || !exists(bookingLimitPath(orgId, resource.data.userId))
          )
        )
        || tokenLimitWasDecremented(orgId, queueId, tokenId, resource.data.userId);
    }

    function validActiveLimitCreate(orgId, uid) {
      let queueId = request.resource.data.lastMutationQueueId;
      let tokenId = request.resource.data.lastMutationTokenId;
      let token = queueTokenPath(orgId, queueId, tokenId);
      return request.resource.data.keys().hasOnly([
          'activeTotal', 'activeByQueue', 'noShowCount', 'cancellationCount',
          'lastMutationTokenId', 'lastMutationQueueId'
        ])
        && request.resource.data.activeTotal == 1
        && request.resource.data.noShowCount == 0
        && request.resource.data.cancellationCount == 0
        && request.resource.data.activeByQueue is map
        && request.resource.data.activeByQueue.keys().hasOnly([queueId])
        && request.resource.data.activeByQueue.get(queueId, 0) == 1
        && tokenId is string
        && queueId is string
        && validNewBookingLimitEvent(orgId, uid, queueId, tokenId, getAfter(token).data.queueDate);
    }

    function validActiveLimitIncrease(orgId, uid) {
      let queueId = request.resource.data.lastMutationQueueId;
      let tokenId = request.resource.data.lastMutationTokenId;
      let token = queueTokenPath(orgId, queueId, tokenId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeTotal', 'activeByQueue', 'noShowCount', 'cancellationCount',
          'lastMutationTokenId', 'lastMutationQueueId'
        ])
        && request.resource.data.activeTotal == resource.data.activeTotal + 1
        && request.resource.data.get('noShowCount', 0) == resource.data.get('noShowCount', 0)
        && request.resource.data.get('cancellationCount', 0) == resource.data.get('cancellationCount', 0)
        && request.resource.data.activeByQueue.diff(resource.data.activeByQueue).affectedKeys().hasOnly([queueId])
        && request.resource.data.activeByQueue.get(queueId, 0)
          == resource.data.activeByQueue.get(queueId, 0) + 1
        && validNewBookingLimitEvent(orgId, uid, queueId, tokenId, getAfter(token).data.queueDate);
    }

    function validActiveLimitDecrease(orgId, uid) {
      let queueId = request.resource.data.lastMutationQueueId;
      let tokenId = request.resource.data.lastMutationTokenId;
      let token = queueTokenPath(orgId, queueId, tokenId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeTotal', 'activeByQueue', 'noShowCount', 'cancellationCount',
          'lastMutationTokenId', 'lastMutationQueueId'
        ])
        && request.resource.data.activeTotal == resource.data.activeTotal - 1
        && request.resource.data.activeTotal >= 0
        && request.resource.data.activeByQueue.diff(resource.data.activeByQueue).affectedKeys().hasOnly([queueId])
        && request.resource.data.activeByQueue.get(queueId, 0)
          == resource.data.activeByQueue.get(queueId, 0) - 1
        && request.resource.data.activeByQueue.get(queueId, 0) >= 0
        && exists(token)
        && get(token).data.userId == uid
        && get(token).data.queueId == queueId
        && get(token).data.limitTracked == true
        && get(token).data.status in ['scheduled', 'waiting', 'serving']
        && existsAfter(token)
        && getAfter(token).data.status in ['cancelled', 'completed', 'no_show']
        && getAfter(token).data.diff(get(token).data).affectedKeys().hasOnly(['status', 'cancelledBy'])
        && (
          getAfter(token).data.status == 'cancelled'
          || !getAfter(token).data.diff(get(token).data).affectedKeys().hasAny(['cancelledBy'])
        )
        && request.resource.data.get('noShowCount', 0)
          == resource.data.get('noShowCount', 0) + (getAfter(token).data.status == 'no_show' ? 1 : 0)
        && request.resource.data.get('cancellationCount', 0)
          == resource.data.get('cancellationCount', 0)
            + (getAfter(token).data.status == 'cancelled'
              && getAfter(token).data.cancelledBy == uid ? 1 : 0);
    }

    function validDailyLimitCreate(orgId, uid, date) {
      let queueId = request.resource.data.lastMutationQueueId;
      let tokenId = request.resource.data.lastMutationTokenId;
      return request.resource.data.keys().hasOnly([
          'total', 'byQueue', 'lastMutationTokenId', 'lastMutationQueueId', 'date'
        ])
        && request.resource.data.total == 1
        && request.resource.data.byQueue is map
        && request.resource.data.byQueue.keys().hasOnly([queueId])
        && request.resource.data.byQueue.get(queueId, 0) == 1
        && request.resource.data.date == date
        && validNewBookingLimitEvent(orgId, uid, queueId, tokenId, date);
    }

    function validDailyLimitIncrease(orgId, uid, date) {
      let queueId = request.resource.data.lastMutationQueueId;
      let tokenId = request.resource.data.lastMutationTokenId;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'total', 'byQueue', 'lastMutationTokenId', 'lastMutationQueueId', 'date'
        ])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.byQueue.diff(resource.data.byQueue).affectedKeys().hasOnly([queueId])
        && request.resource.data.byQueue.get(queueId, 0) == resource.data.byQueue.get(queueId, 0) + 1
        && request.resource.data.date == date
        && validNewBookingLimitEvent(orgId, uid, queueId, tokenId, date);
    }

    function lastIssuedTokenContinues(orgId, queueId, counterKey, tokenNumber) {
      return resource.data.lastIssuedTokenId is string
        && resource.data.lastIssuedTokenId != ''
        && exists(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(resource.data.lastIssuedTokenId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(resource.data.lastIssuedTokenId)).data.counterKey == counterKey
        && get(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(resource.data.lastIssuedTokenId)).data.tokenNumber is int
        && get(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(resource.data.lastIssuedTokenId)).data.tokenNumber + 1 == tokenNumber;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['user', 'org_admin']
        && (
          request.resource.data.role == 'user'
          || (
            request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email
            && !publicDomain(request.resource.data.email)
            && request.resource.data.orgId == uid
            && existsAfter(/databases/$(database)/documents/organizations/$(uid))
            && getAfter(/databases/$(database)/documents/organizations/$(uid)).data.adminUid == uid
          )
        );
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'joinedOrgs', 'name', 'admissionId', 'employeeId', 'department'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
          || (
            request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admissionId'])
          || (request.resource.data.admissionId is string && request.resource.data.admissionId.size() <= 100)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['employeeId'])
          || (request.resource.data.employeeId is string && request.resource.data.employeeId.size() <= 100)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['department'])
          || (request.resource.data.department is string && request.resource.data.department.size() <= 100)
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == orgId
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.officialEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.joinCode.matches('^[A-Z0-9]{6}$')
        && !publicDomain(request.resource.data.officialEmail)
        && existsAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && getAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.ownerUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/orgSlugs/$(request.resource.data.slug))
        && getAfter(/databases/$(database)/documents/orgSlugs/$(request.resource.data.slug)).data.ownerUid == request.auth.uid
        && validOrgAdminProfile(request.auth.uid, orgId);
      allow update: if isVerifiedOrgAdmin()
        && resource.data.adminUid == request.auth.uid;
      allow delete: if isVerifiedOrgAdmin()
        && resource.data.adminUid == request.auth.uid;

      match /bookingLimits/{uid} {
        allow read: if signedIn()
          && (request.auth.uid == uid || isVerifiedOrgAdminFor(orgId));
        allow create: if signedIn()
          && request.auth.uid == uid
          && validActiveLimitCreate(orgId, uid);
        allow update: if (
            signedIn()
            && request.auth.uid == uid
            && validActiveLimitIncrease(orgId, uid)
          )
          || (
            signedIn()
            && (request.auth.uid == uid || isVerifiedOrgAdminFor(orgId))
            && validActiveLimitDecrease(orgId, uid)
          )
          || (
            isVerifiedOrgAdminFor(orgId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'noShowCount', 'cancellationCount'
            ])
            && request.resource.data.noShowCount == 0
            && request.resource.data.cancellationCount == 0
          );
        allow delete: if false;

        match /days/{date} {
          allow read: if signedIn()
            && (request.auth.uid == uid || isVerifiedOrgAdminFor(orgId));
          allow create: if signedIn()
            && request.auth.uid == uid
            && validDailyLimitCreate(orgId, uid, date);
          allow update: if signedIn()
            && request.auth.uid == uid
            && validDailyLimitIncrease(orgId, uid, date);
          allow delete: if false;
        }
      }

      match /bookingRestrictions/{uid} {
        allow read: if signedIn()
          && (request.auth.uid == uid || isVerifiedOrgAdminFor(orgId));
        allow create, update: if isVerifiedOrgAdminFor(orgId)
          && request.resource.data.keys().hasOnly(['reason', 'updatedBy', 'updatedAt'])
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isVerifiedOrgAdminFor(orgId);
      }

      match /appointments/{appointmentId} {
        allow read: if signedIn()
          && (resource.data.userId == request.auth.uid
            || isVerifiedOrgAdminFor(orgId));
        allow create: if false;
        allow update: if (
            isVerifiedOrgAdminFor(orgId)
            && resource.data.status in ['booked', 'checked_in']
            && request.resource.data.status in ['checked_in', 'completed', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          || (
            signedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status in ['booked', 'checked_in']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          );
        allow delete: if signedIn()
          && (resource.data.userId == request.auth.uid
            || isVerifiedOrgAdminFor(orgId));
      }

      match /queue/{tokenId} {
        allow read: if signedIn();
        allow create: if false;
        allow update, delete: if isVerifiedOrgAdminFor(orgId);
      }

      match /queues/{queueId} {
        allow read: if signedIn();
        allow create, delete: if isVerifiedOrgAdminFor(orgId);
        allow update: if isVerifiedOrgAdminFor(orgId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyCounters', 'lastIssuedTokenId'])
            && request.resource.data.dailyCounters is map
            && request.resource.data.lastIssuedTokenId is string
            && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId))
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.queueId == queueId
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey is string
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey
              == getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.queueDate
                + '__'
                + getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.serviceId
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber is int
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber > 0
            && request.resource.data.dailyCounters.diff(resource.data.get('dailyCounters', {})).affectedKeys().hasOnly([
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey
            ])
            && request.resource.data.dailyCounters.get(
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey,
              0
            ) == getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber + 1
            && (
              resource.data.get('dailyCounters', {}).get(
                getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey,
                -1
              ) == getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber
              || (
                !resource.data.get('dailyCounters', {}).keys().hasAny([
                  getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey
                ])
                && (
                  getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber == 1
                  || getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber == resource.data.get('nextTokenNumber', 1)
                  || lastIssuedTokenContinues(
                    orgId,
                    queueId,
                    getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.counterKey,
                    getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)/tokens/$(request.resource.data.lastIssuedTokenId)).data.tokenNumber
                  )
                )
              )
            )
          );

        match /tokens/{tokenId} {
          allow read: if signedIn();
          allow create: if isEligibleCustomerForOrg(orgId, request.auth.uid)
            && !exists(/databases/$(database)/documents/organizations/$(orgId)/bookingRestrictions/$(request.auth.uid))
            && request.resource.data.keys().hasOnly([
              'tokenNumber', 'userId', 'userName', 'queueId', 'queueName',
              'serviceId', 'serviceName', 'queueDate', 'timeSlot',
              'counterKey', 'status', 'limitTracked', 'createdAt'
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.queueId == queueId
            && request.resource.data.userName is string
            && request.resource.data.queueName is string
            && request.resource.data.status in ['scheduled', 'waiting']
            && request.resource.data.limitTracked == true
            && request.resource.data.queueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.timeSlot.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.serviceId is string
            && request.resource.data.serviceName is string
            && request.resource.data.counterKey == request.resource.data.queueDate + '__' + request.resource.data.serviceId
            && exists(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId))
            && request.resource.data.tokenNumber is int
            && request.resource.data.tokenNumber > 0
            && request.resource.data.createdAt is timestamp
            && bookingCountsWithinLimits(
              orgId,
              request.auth.uid,
              queueId,
              tokenId,
              request.resource.data.queueDate
            )
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)).data.dailyCounters.get(request.resource.data.counterKey, 0) == request.resource.data.tokenNumber + 1
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)).data.lastIssuedTokenId == tokenId
            && (
              request.resource.data.status == 'scheduled'
              || (
                get(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)).data.status == 'open'
                && get(/databases/$(database)/documents/organizations/$(orgId)/queues/$(queueId)).data.get('activeDate', request.resource.data.queueDate) == request.resource.data.queueDate
              )
            );
          allow update: if (
              isVerifiedOrgAdminFor(orgId)
              && resource.data.status in ['scheduled', 'waiting', 'serving']
              && request.resource.data.status in ['waiting', 'serving', 'completed', 'cancelled', 'no_show']
              && (
                request.resource.data.status != 'no_show'
                || resource.data.status in ['scheduled', 'waiting']
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'calledAt', 'promotedAt', 'cancelledBy'
              ])
              && (
                request.resource.data.status != 'cancelled'
                || request.resource.data.cancelledBy == request.auth.uid
              )
              && (
                request.resource.data.status == 'cancelled'
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelledBy'])
              )
              && (
                request.resource.data.status in ['waiting', 'serving']
                || tokenCanBecomeInactive(orgId, queueId, tokenId)
              )
            )
            || (
              signedIn()
              && resource.data.userId == request.auth.uid
              && resource.data.status in ['scheduled', 'waiting', 'serving']
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy'])
              && tokenCanBecomeInactive(orgId, queueId, tokenId)
            );
          allow delete: if false;
        }
      }
    }

    match /{path=**}/appointments/{appointmentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/tokens/{tokenId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orgId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/organizations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.adminUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.officialEmail == request.auth.token.email
        && !publicDomain(getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.officialEmail)
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.joinCode == code
        && validOrgAdminProfile(request.auth.uid, request.auth.uid);
      allow update, delete: if false;
    }

    match /orgSlugs/{slug} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.slug == slug
        && existsAfter(/databases/$(database)/documents/organizations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.adminUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.officialEmail == request.auth.token.email
        && !publicDomain(getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.officialEmail)
        && getAfter(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.slug == slug
        && validOrgAdminProfile(request.auth.uid, request.auth.uid);
      allow update, delete: if false;
    }
  }
}
