# Firebase-backed UI (required for Firebase Auth and Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Firebase Analytics identifier
VITE_FIREBASE_MEASUREMENT_ID=

# SQLite API mode (optional; defaults shown)
PORT=3001
DATABASE_PATH=./data/qline.sqlite
BUSINESS_EMAILS=
STAFF_EMAILS=
# Set true only when the API is served over HTTPS; production always sets Secure.
COOKIE_SECURE=false
